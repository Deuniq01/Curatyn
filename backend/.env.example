# ---- Database -------------------------------------------------------------
# Local dev:
#   postgresql+asyncpg://curatyn:curatyn@localhost:5432/curatyn
# Supabase (Session pooler — copy from Project Settings > Database, then change
# the scheme to postgresql+asyncpg://). SSL + pgbouncer settings are handled
# automatically in app/db.py for supabase hosts.
DATABASE_URL=postgresql+asyncpg://curatyn:curatyn@localhost:5432/curatyn
# Keep true in production. Set false only for a local TLS-inspecting proxy.
DATABASE_SSL_VERIFY=true

# ---- Secrets (generate real values; never commit real ones) ---------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CURATYN_TOKEN_ENCRYPTION_KEY=generate-with-fernet-generate-key

# ---- AI -------------------------------------------------------------------
# mock | gemini | ollama
AI_BACKEND=mock
# Gemini API key from https://aistudio.google.com/apikey (needed when AI_BACKEND=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- Email ----------------------------------------------------------------
# mock | live
EMAIL_BACKEND=mock

# Google OAuth (Gmail send). Redirect URI must EXACTLY match the one registered
# in Google Cloud Console. Prod example: https://<your-backend>.onrender.com/api/auth/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/gmail/callback

# Microsoft OAuth (Outlook send) — optional, only if you support Outlook.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/oauth/outlook/callback

# ---- Storage --------------------------------------------------------------
# local | supabase  (local disk is ephemeral on Render — use supabase in prod)
STORAGE_BACKEND=local
STORAGE_DIR=./local_storage
# Supabase Storage (needed when STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=cvs

# ---- Web / CORS -----------------------------------------------------------
# Where the browser app runs (used for the post-OAuth redirect back).
FRONTEND_URL=http://localhost:3000
# Comma-separated origins allowed to call this API. Prod example:
#   https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
